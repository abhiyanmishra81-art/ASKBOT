# Set these in your host's dashboard (or export them locally).
LLM_API_KEY=your-free-key-here

# Optional. Defaults are for Groq's free tier.
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# MODEL=llama-3.3-70b-versatile
# RATE_LIMIT_PER_MINUTE=15

# Other providers with an OpenAI-style API (check their docs for the current model name):
# Gemini:     LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# OpenRouter: LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
